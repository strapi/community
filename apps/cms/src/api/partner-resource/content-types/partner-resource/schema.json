{
  "kind": "collectionType",
  "collectionName": "partner_resources",
  "info": {
    "singularName": "partner-resource",
    "pluralName": "partner-resources",
    "displayName": "Partner Resources",
    "description": "Gated content for the partner portal's Sales enablement, Tech enablement and Reusable content sections."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "section": {
      "type": "enumeration",
      "required": true,
      "enum": ["sales_enablement", "tech_enablement", "reusable_content"]
    },
    "minimum_level": {
      "type": "enumeration",
      "required": true,
      "default": "Community",
      "enum": ["Unlisted", "Community", "Business", "Enterprise"]
    },
    "category": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::strapi-lucide-icons.icon"
    },
    "content": {
      "type": "richtext"
    },
    "file": {
      "type": "media",
      "multiple": false
    },
    "link": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  }
}
